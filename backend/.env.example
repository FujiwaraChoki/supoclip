# The model size of OpenAI Whisper (see https://github.com/openai/whisper#available-models-and-languages)
# Used when TRANSCRIPTION_PROVIDER=whisper
WHISPER_MODEL_SIZE=medium

# Transcription provider: assemblyai (default), whisper, or youtube_captions
# - assemblyai: cloud API, best accuracy with speaker diarization (requires ASSEMBLY_AI_API_KEY)
# - whisper: local transcription, no API key needed
# - youtube_captions: extract from YouTube captions (YouTube-sourced only)
TRANSCRIPTION_PROVIDER=assemblyai

# LLM Providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
YOUTUBE_DATA_API_KEY=
ANTHROPIC_API_KEY=
# Optional. Defaults to http://localhost:11434/v1 for local backend runs,
# or http://host.docker.internal:11434/v1 inside Docker.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# The AI Model to use throughout the app
LLM=google-gla:gemini-3-flash-preview

# Prevent tasks from sitting in queued forever if worker is down
QUEUED_TASK_TIMEOUT_SECONDS=180

# YouTube metadata lookup provider: `yt_dlp` or `youtube_data_api`
YOUTUBE_METADATA_PROVIDER=yt_dlp

# Processing defaults
DEFAULT_PROCESSING_MODE=fast
FAST_MODE_MAX_CLIPS=4
FAST_MODE_TRANSCRIPT_MODEL=nano

# Good for speed optimizations
COMPOSE_BAKE=true

# DB
POSTGRES_DB=supoclip
POSTGRES_USER=supoclip
POSTGRES_PASSWORD=supoclip_password

ASSEMBLY_AI_API_KEY=

# Discord webhook URLs (each posts to a separate channel)
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_SALES_WEBHOOK_URL=

# Monetization (only enabled when SELF_HOST=false)
SELF_HOST=true
BACKEND_AUTH_SECRET=change_me_backend_auth_secret
APP_SETTINGS_ENCRYPTION_KEY=change_me_settings_encryption_secret
ALLOW_UNSIGNED_BACKEND_AUTH=false
AUTH_SIGNATURE_TTL_SECONDS=300
CORS_ORIGINS=http://localhost:3000,http://sp.localhost:3000,http://supoclip.localhost:3000
# Hosted mode requires a paid subscription. Monthly allowance in minutes of
# source video (0 = unlimited).
PRO_PLAN_MINUTE_LIMIT=600
SCALE_PLAN_MINUTE_LIMIT=1500

# Durable media: local for self-hosting, s3 for private object storage.
# IAM roles/default AWS credentials work when dedicated media keys are blank.
MEDIA_STORAGE=local
MEDIA_S3_BUCKET=
MEDIA_S3_PREFIX=media
MEDIA_S3_REGION=eu-central-1
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_SESSION_TOKEN=
MEDIA_URL_TTL_SECONDS=900
MEDIA_CACHE_TTL_SECONDS=86400
MEDIA_ORPHAN_GRACE_SECONDS=86400
MEDIA_UPLOAD_CONCURRENCY=3
MEDIA_UPLOAD_DAILY_LIMIT=20
