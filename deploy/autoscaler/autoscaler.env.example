# /etc/supoclip-autoscaler/autoscaler.env (mode 0600, owner supoclip-autoscaler).
# Read docs/autoscaling.md. Values below are the defaults unless marked required.

# Kill switch. Nothing happens unless this is true.
AUTOSCALER_ENABLED=false
# Read everything and log the decision, change nothing, send no alerts.
AUTOSCALER_DRY_RUN=false

# When to add a worker: the oldest startable queued task has waited this long, or this many are queued.
AUTOSCALER_SCALE_UP_WAIT_MINUTES=10
AUTOSCALER_SCALE_UP_QUEUE_DEPTH=20
AUTOSCALER_SCALE_UP_COOLDOWN_MINUTES=10
# When to remove one: nothing running on it and nothing queued for this long.
AUTOSCALER_IDLE_MINUTES=30

# Limits.
AUTOSCALER_MAX_EXTRA_WORKERS=2
AUTOSCALER_DAILY_SPEND_CAP_EUR=40
# Used until the cloud API reports the server type's price.
AUTOSCALER_HOURLY_PRICE_EUR=0.7847
# Kept free in PostgreSQL (max_connections) before another worker is added.
AUTOSCALER_DB_CONNECTIONS_PER_WORKER=25
AUTOSCALER_DB_CONNECTION_RESERVE=20
# After a cloud API error (e.g. a core limit) or a failed scale-up, no scale-up for this long.
AUTOSCALER_ERROR_BACKOFF_MINUTES=30

# The machine.
AUTOSCALER_SERVER_TYPE=ccx53
AUTOSCALER_LOCATION=hel1
AUTOSCALER_WORKER_CONCURRENCY=10
# Seconds between a cloud worker's looks at the queue. Longer than an always-on
# host's 0.5 s, so that host takes a job first when it has a free slot.
AUTOSCALER_WORKER_POLL_SECONDS=5
# Defaults to the concurrency.
AUTOSCALER_WORKER_DB_POOL_SIZE=
AUTOSCALER_WORKER_DB_MAX_OVERFLOW=5
AUTOSCALER_NAME_PREFIX=supoclip-render-auto
AUTOSCALER_SNAPSHOT_SELECTOR=supoclip-render-golden=true
# Names (not ids) of the cloud firewall and the cloud SSH key to attach. Optional.
AUTOSCALER_FIREWALL=
AUTOSCALER_CLOUD_SSH_KEY=

# Required: a file holding the cloud API token (or an hcloud CLI config).
AUTOSCALER_HCLOUD_TOKEN_FILE=/etc/supoclip-autoscaler/hcloud-token

# Which backend release new workers run: the image of a running container on this
# host (container:<name>) or a file the deploy flow writes (file:<path>).
AUTOSCALER_IMAGE_SOURCE=container:supoclip-worker
# The backend container the queue probe runs in.
AUTOSCALER_PROBE_CONTAINER=supoclip-worker

# Required: copied to each new worker over SSH stdin, never on a command line.
# The worker's service credentials (same as the primary render host's worker.env,
# with database/Redis addresses pointing at its loopback tunnel ports).
AUTOSCALER_WORKER_ENV_FILE=/etc/supoclip-autoscaler/worker.env
# WORKER_DATABASE_URL, WORKER_REDIS_HOST/PORT and any proxy settings for the compose file.
AUTOSCALER_COMPOSE_ENV_FILE=/etc/supoclip-autoscaler/render-compose.env
# The YouTube proxy secret mounted at /run/proxy-secret.json. Optional.
AUTOSCALER_PROXY_SECRET_FILE=

# SSH to the workers as the admin user baked into the golden snapshot.
AUTOSCALER_SSH_KEY=/etc/supoclip-autoscaler/admin_key
AUTOSCALER_SSH_USER=supoclip
AUTOSCALER_STATE_DIR=/var/lib/supoclip-autoscaler
AUTOSCALER_TUNNEL_UNIT=supoclip-render-tunnel

# Ops alerts to the operator chat (signed like the other Hermes routes). Optional.
HERMES_OPS_ALERT_URL=
HERMES_OPS_ALERT_SECRET=
