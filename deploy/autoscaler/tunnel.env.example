# /etc/supoclip-autoscaler/tunnel.env: loopback gateways on the application host
# that the per-worker reverse tunnels forward to. See docs/autoscaling.md.
# Not the host's own 5432: point at a gateway that reaches the SupoClip database.
POSTGRES_GATEWAY_PORT=25432
REDIS_GATEWAY_PORT=6379
BGUTIL_GATEWAY_PORT=24416
