# Settings for deploy/render-worker/compose.yml only.
# Service credentials go in WORKER_ENV_FILE (mode 0600), not here.

# The backend image of the release the application host runs.
WORKER_IMAGE=
WORKER_ENV_FILE=/etc/supoclip/worker.env

# The application host's PostgreSQL and Redis, over a private connection.
# postgresql+asyncpg://USER:PASSWORD@HOST:PORT/supoclip
WORKER_DATABASE_URL=
WORKER_REDIS_HOST=127.0.0.1
WORKER_REDIS_PORT=6379

# A directory on this machine's own disk for downloads, caches and renders.
WORKER_SCRATCH_PATH=/srv/supoclip-scratch
