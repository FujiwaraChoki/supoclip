// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Public component status, editable without a frontend deployment.
model ServiceStatus {
  id          String   @id @db.VarChar(80)
  name        String   @db.VarChar(120)
  status      String   @db.VarChar(20)
  headline    String   @db.VarChar(120)
  description String   @db.VarChar(2000)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("service_statuses")
}

// Announcements managed by admins without a frontend deployment.
model Announcement {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(120)
  description String   @db.VarChar(2000)
  href        String   @db.VarChar(500)
  action      String   @db.VarChar(80)
  isPublished Boolean  @default(false) @map("is_published")
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([isPublished, publishedAt])
  @@map("announcements")
}

// Better Auth User model with backend compatibility
model EmailDelivery {
  message_id String   @id @db.VarChar(255)
  recipient  String   @db.VarChar(255)
  subject    String   @db.Text
  region     String   @db.VarChar(64)
  sent_at    DateTime @default(now()) @db.Timestamptz

  @@index([recipient], map: "ix_email_deliveries_recipient")
  @@map("email_deliveries")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz
  updatedAt     DateTime  @updatedAt @db.Timestamptz

  // Additional fields for backend compatibility
  first_name    String?   @db.VarChar(100)
  last_name     String?   @db.VarChar(100)
  password_hash String?   @db.VarChar(255)

  // Default font preferences
  default_font_family String?   @default("TikTokSans-Regular") @db.VarChar(100)
  default_font_size   Int?      @default(24)
  default_font_color  String?   @default("#FFFFFF") @db.VarChar(7)
  notify_on_completion Boolean  @default(true)
  default_clip_length  String   @default("auto") @db.VarChar(10)
  product_updates_unsubscribed_at DateTime? @db.Timestamptz

  // Monetization and billing
  plan                 String    @default("free") @db.VarChar(20)
  subscription_status  String    @default("inactive") @db.VarChar(20)
  subscription_provider String?   @db.VarChar(20)
  is_admin             Boolean   @default(false)
  stripe_customer_id   String?   @unique @db.VarChar(255)
  stripe_subscription_id String? @unique @db.VarChar(255)
  billing_period_start DateTime? @db.Timestamptz
  billing_period_end   DateTime? @db.Timestamptz
  trial_ends_at        DateTime? @db.Timestamptz
  subscription_cancel_at DateTime? @db.Timestamptz
  // Pro subscribers from before the 720p change keep 1080p while subscribed
  legacy_hd            Boolean   @default(false)
  // Higher tier chosen in the billing portal, granted only after its invoice is paid.
  pending_plan            String? @db.VarChar(20)
  pending_plan_invoice_id String? @db.VarChar(255)

  // Relationships
  tasks         Task[]
  sessions      Session[]
  accounts      Account[]
  app_settings  AppSetting[]
  acquisition   UserAcquisition?
  affiliate     Affiliate?  @relation("AffiliateApplicant")
  reviewed_affiliates Affiliate[] @relation("AffiliateReviewer")
  social_accounts     SocialAccount[]
  social_oauth_states SocialOauthState[]
  social_posts        SocialPost[]

  @@map("users")
}

// First-touch campaign attribution, written once shortly after sign-up.
model UserAcquisition {
  user_id                String    @id @db.VarChar(36)
  utm_source             String?   @db.VarChar(100)
  utm_medium             String?   @db.VarChar(100)
  utm_campaign           String?   @db.VarChar(100)
  utm_content            String?   @db.VarChar(100)
  utm_term               String?   @db.VarChar(100)
  ref                    String?   @db.VarChar(100)
  referrer_host          String?   @db.VarChar(255)
  landing_path           String?   @db.VarChar(512)
  first_seen_at          DateTime? @db.Timestamptz
  first_clip_exported_at DateTime? @db.Timestamptz
  created_at             DateTime  @default(now()) @db.Timestamptz

  user                   User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([utm_source, utm_campaign])
  @@map("user_acquisition")
}

/// Creator program application. `slug` is the lowercase ref/code; it is
/// cleared on decline so the name becomes available again.
model Affiliate {
  id                       String    @id @default(uuid()) @db.VarChar(36)
  user_id                  String    @unique @db.VarChar(36)
  slug                     String?   @unique @db.VarChar(20)
  status                   String    @default("pending") @db.VarChar(20)
  platform                 String    @db.VarChar(20)
  profile_url              String    @db.VarChar(500)
  audience_size            String    @db.VarChar(20)
  video_url                String?   @db.VarChar(500)
  promotion_plan           String?   @db.VarChar(1000)
  decline_reason           String?   @db.VarChar(1000)
  stripe_promotion_code_id String?   @db.VarChar(255)
  /// When an admin added the creator's custom code to the App Store "Creator offer".
  app_store_code_added_at  DateTime? @db.Timestamptz
  terms_accepted_at        DateTime  @db.Timestamptz
  reviewed_at              DateTime? @db.Timestamptz
  reviewed_by              String?   @db.VarChar(36)
  created_at               DateTime  @default(now()) @db.Timestamptz
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamptz

  user     User  @relation("AffiliateApplicant", fields: [user_id], references: [id], onDelete: Cascade)
  reviewer User? @relation("AffiliateReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@index([status, created_at])
  @@map("affiliates")
}

model AppSetting {
  setting_key     String   @id @db.VarChar(100)
  encrypted_value String
  prefer_admin_value Boolean @default(false)
  updated_by      String?  @db.VarChar(36)
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz

  user            User?    @relation(fields: [updated_by], references: [id], onDelete: SetNull)

  @@index([updated_by])
  @@map("app_settings")
}

// Durable billing charges with failure refunds. No task/user relation: deletion must retain usage
// and the original task idempotency key. The backend owns all writes.
model MinuteUsageEvent {
  id                      String   @id @db.VarChar(36)
  user_id                 String
  task_id                 String?  @unique
  minutes                 Int
  source_duration_seconds Int
  created_at              DateTime @default(now()) @db.Timestamptz
  refunded_at             DateTime? @db.Timestamptz

  @@index([user_id, created_at], map: "ix_minute_usage_events_user_created")
  @@map("minute_usage_events")
}

model Task {
  id                   String    @id @default(uuid())
  user_id              String
  source_id            String?
  generated_clips_ids  String[]
  status               String    @default("pending") @db.VarChar(20)
  progress             Int?      @default(0)
  progress_message     String?
  source_metadata      Json      @default("{}") @db.JsonB
  source_duration_seconds Int?
  completion_notification_sent_at DateTime? @db.Timestamptz
  share_token          String?   @unique @db.VarChar(64)
  share_enabled        Boolean   @default(false)

  // Font customization fields
  font_family          String?   @default("TikTokSans-Regular") @db.VarChar(100)
  font_size            Int?      @default(24)
  font_color           String?   @default("#FFFFFF") @db.VarChar(7)
  caption_template     String?   @default("default") @db.VarChar(50)
  include_broll        Boolean?  @default(false)

  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamptz

  // Relationships
  user                 User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  source               Source?   @relation(fields: [source_id], references: [id], onDelete: SetNull)
  social_posts         SocialPost[]

  @@index([user_id])
  @@index([source_id])
  @@index([created_at])
  @@index([status])
  @@map("tasks")
}

// Social publishing. Owned by the backend (raw SQL, tokens encrypted with the
// backend key); mirrored here so both migration runners create the same tables.
model SocialAccount {
  id                      String    @id @default(dbgenerated("(uuid_generate_v4())::text")) @db.VarChar(36)
  user_id                 String    @db.VarChar(36)
  provider                String    @db.VarChar(20)
  external_account_id     String    @db.VarChar(255)
  display_name            String?   @db.VarChar(255)
  username                String?   @db.VarChar(255)
  avatar_url              String?
  access_token_encrypted  String
  refresh_token_encrypted String?
  token_expires_at        DateTime? @db.Timestamptz
  scopes                  String?
  metadata                Json      @default("{}") @db.JsonB
  status                  String    @default("active") @db.VarChar(20)
  last_error              String?
  created_at              DateTime? @default(now()) @db.Timestamptz
  updated_at              DateTime? @default(now()) @db.Timestamptz
  revoked_at              DateTime? @db.Timestamptz

  user  User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  posts SocialPost[]

  @@unique([user_id, provider, external_account_id], map: "idx_social_accounts_unique_account")
  @@index([user_id], map: "idx_social_accounts_user_id")
  @@map("social_accounts")
}

model SocialOauthState {
  state         String    @id @db.VarChar(128)
  user_id       String    @db.VarChar(36)
  provider      String    @db.VarChar(20)
  code_verifier String?   @db.VarChar(255)
  redirect_uri  String
  created_at    DateTime? @default(now()) @db.Timestamptz
  expires_at    DateTime  @db.Timestamptz

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires_at], map: "idx_social_oauth_states_expires_at")
  @@map("social_oauth_states")
}

model SocialPost {
  id                     String    @id @default(dbgenerated("(uuid_generate_v4())::text")) @db.VarChar(36)
  user_id                String    @db.VarChar(36)
  task_id                String?   @db.VarChar(36)
  /// generated_clips(id), ON DELETE SET NULL (generated_clips is not modeled here).
  clip_id                String?   @db.VarChar(36)
  social_account_id      String?   @db.VarChar(36)
  provider               String    @db.VarChar(20)
  status                 String    @default("queued") @db.VarChar(20)
  scheduled_for          DateTime? @db.Timestamptz
  title                  String?   @db.VarChar(255)
  caption                String?
  hashtags               String[]  @default([])
  privacy_level          String    @default("public") @db.VarChar(40)
  media_token            String?   @unique @db.VarChar(64)
  media_token_expires_at DateTime? @db.Timestamptz
  source_file_path       String?
  pending_handle         String?   @db.VarChar(255)
  external_post_id       String?   @db.VarChar(255)
  external_url           String?
  error_message          String?
  attempts               Int       @default(0)
  claimed_at             DateTime? @db.Timestamptz
  hook_type              String?   @db.VarChar(50)
  hook_title             String?   @db.VarChar(255)
  virality_score         Int?
  hook_score             Int?
  engagement_score       Int?
  value_score            Int?
  shareability_score     Int?
  clip_duration          Float?
  published_at           DateTime? @db.Timestamptz
  last_metrics_at        DateTime? @db.Timestamptz
  metrics                Json?     @db.JsonB
  created_at             DateTime? @default(now()) @db.Timestamptz
  updated_at             DateTime? @default(now()) @db.Timestamptz

  user           User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  task           Task?              @relation(fields: [task_id], references: [id], onDelete: SetNull)
  social_account SocialAccount?     @relation(fields: [social_account_id], references: [id], onDelete: SetNull)
  metric_history SocialPostMetric[]

  @@index([user_id], map: "idx_social_posts_user_id")
  @@index([clip_id], map: "idx_social_posts_clip_id")
  @@index([task_id], map: "idx_social_posts_task_id")
  @@index([status, scheduled_for], map: "idx_social_posts_status_scheduled")
  @@map("social_posts")
}

model SocialPostMetric {
  id          String    @id @default(dbgenerated("(uuid_generate_v4())::text")) @db.VarChar(36)
  post_id     String    @db.VarChar(36)
  captured_at DateTime? @default(now()) @db.Timestamptz
  views       BigInt?
  likes       BigInt?
  comments    BigInt?
  shares      BigInt?
  saves       BigInt?
  raw         Json?     @db.JsonB

  post SocialPost @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([post_id, captured_at(sort: Desc)], map: "idx_social_post_metrics_post_id")
  @@map("social_post_metrics")
}

model Source {
  id         String   @id @default(uuid())
  type       String   @db.VarChar(20)
  title      String   @db.VarChar(500)
  url        String?  @db.VarChar(1000)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz

  // Relationships
  tasks      Task[]

  @@index([created_at])
  @@map("sources")
}

// Better Auth Session management
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model StripeWebhookEvent {
  id         String   @id
  type       String
  created_at DateTime @default(now()) @db.Timestamptz

  @@map("stripe_webhook_events")
}

model RevenueCatWebhookEvent {
  id         String   @id
  type       String
  created_at DateTime @default(now()) @db.Timestamptz

  @@map("revenuecat_webhook_events")
}
