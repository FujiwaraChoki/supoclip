    "FaceTrack": {
      "additionalProperties": false,
      "description": "Normalised (0-1) face boxes at `fps`. space \"picture\" = relative to the base picture (generation: the framed\noutput frame; studio: layout.mp4 or clean.mp4 frame). Each face row is [x,y,w,h,score] or\n[x,y,w,h,score, rex,rey, lex,ley, nx,ny, rmx,rmy, lmx,lmy] (YuNet landmark order). Largest face first, ≤ 2 faces.",
      "properties": {
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "space": {
          "default": "picture",
          "enum": [
            "picture",
            "output"
          ],
          "title": "Space",
          "type": "string"
        },
        "fps": {
          "default": 6,
          "exclusiveMinimum": 0,
          "maximum": 30,
          "title": "Fps",
          "type": "number"
        },
        "samples": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "items": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "type": "array"
              }
            ],
            "type": "array"
          },
          "title": "Samples",
          "type": "array"
        }
      },
      "title": "FaceTrack",
      "type": "object"
    },
